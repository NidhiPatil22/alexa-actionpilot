# AWS Configuration (Amazon Bedrock & DynamoDB)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_key_or_real
AWS_SECRET_ACCESS_KEY=mock_secret_or_real
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# DynamoDB Configuration
DYNAMODB_TABLE_PREFIX=ActionPilot
USE_LOCAL_STORAGE=true

# Amazon Bedrock AgentCore Memory
AGENTCORE_MEMORY_ID=mem-actionpilot-hackathon-2026

# MCP Server Configuration
PORT=3001
MCP_BASE_URL=http://localhost:3001
MCP_STREAMABLE_HTTP=true
MCP_SPEC_VERSION=2025-11-25

# Web Dashboard Configuration
VITE_MCP_SERVER_URL=http://localhost:3001
VITE_APP_TITLE=ActionPilot - Next-Best-Action Engine for Alexa+
